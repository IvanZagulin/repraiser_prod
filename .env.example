# Database
POSTGRES_DB=wb_repricer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD>

# JWT Secret (минимум 32 символа)
JWT_SECRET=<GENERATE_SECRET_32_CHARS>

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SOCKS5 прокси для WB API (опционально, формат: host:port:user:pass;...)
SOCKS5_PROXIES=

# HTTP/SOCKS5 прокси для парсинга каталога WB card.wb.ru (опционально)
# Формат: http://host:port или http://user:pass@host:port
CATALOG_PROXY_URL=

# API URL для фронтенда
VITE_API_URL=https://your-domain.com

# Admin аккаунт (создаётся при первом старте)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=<STRONG_PASSWORD>

# SMTP для welcome-писем (опционально)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=https://your-domain.com

# Redis (генерируется автоматически)
REDIS_PASSWORD=<GENERATE_SECRET>

# Fernet key для шифрования (генерируется автоматически)
FERNET_KEY=<GENERATE_FERNET_KEY>

# CORS Origins (список разрешённых доменов)
CORS_ORIGINS=https://admin.your-domain.com
